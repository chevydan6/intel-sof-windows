; SPDX-License-Identifier: GPL-2.0-only
; RT5682 codec identification over the ACPI-provided I2C connection.

[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=10/14/2026,0.1.0.0
CatalogFile=sofrt5682.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
sofrt5682.sys=1,,

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceName%=Install,ACPI\10EC5682

[Install.NT]
CopyFiles=DriverFiles

[Install.NT.HW]
AddReg=DeviceSecurity

[DeviceSecurity]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[DriverFiles]
sofrt5682.sys

[Install.NT.Services]
AddService=sofrt5682,0x00000002,Service

[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\sofrt5682.sys

[Install.NT.Wdf]
KmdfService=sofrt5682,WdfSection

[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="Open SOF Windows Project"
DeviceName="RT5682 headphone codec (development, identification only)"
ServiceName="SOF RT5682 headphone codec"
DiskName="SOF RT5682 codec development package"
